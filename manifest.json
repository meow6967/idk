{
  "manifest_version": 3,
  "name": "Page Blur",
  "version": "1.0",
  "description": "Blur the current webpage when clicking the extension icon",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Click to blur/unblur page"
  },
  "background": {
    "service_worker": "blur-background.js"
  }
}
